/*
 * Configuration for the contract-gated curation pipeline.
 *
 * Local execution only. No executor, container registry or cloud profile is
 * configured, because none of those is what this pipeline demonstrates.
 */

manifest {
    name            = 'bio-governance-lab/contract-gate'
    description     = 'Contract-gated curation of a synthetic study.'
    author          = 'Ron Finn'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    // Directory holding study.json, samples.csv, compounds.csv, expression.csv.
    study_dir          = "${projectDir}/../../data/raw/BIO-001"

    samples_contract   = "${projectDir}/../../contracts/samples.v1.yaml"
    compounds_contract = "${projectDir}/../../contracts/compounds.v1.yaml"

    outdir             = "${projectDir}/../../results"

    // How to reach the installed CLI. `uv run --project` resolves the project
    // environment without depending on the directory a process happens to run
    // in; override with --bio_gov if bio-gov is already on PATH.
    bio_gov            = "uv run --project ${projectDir}/../.. bio-gov"
}

process {
    // A contract violation must stop the run, not be retried or ignored.
    errorStrategy = 'terminate'
}
